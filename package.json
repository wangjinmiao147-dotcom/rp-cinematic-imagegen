{
    "name": "sillytavern-rp-cinematic-imagegen",
    "version": "2.9.63",
    "private": true,
    "description": "SillyTavern 电影级角色扮演配图扩展",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/wangjinmiao147-dotcom/rp-cinematic-imagegen.git"
    },
    "scripts": {
        "check": "node scripts/check-release.mjs",
        "test": "node scripts/run-tests.mjs",
        "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
        "prepare:repo": "node scripts/prepare-github.mjs",
        "docs:prompts": "node scripts/update-prompt-library-docs.mjs",
        "test:android": "node scripts/test-android.mjs",
        "test:android:server": "node scripts/android-fixture-server.mjs",
        "test:android:gallery": "node scripts/test-android-gallery.mjs",
        "test:android:settings": "node scripts/test-android-settings.mjs",
        "test:android:import": "node scripts/test-android-import.mjs",
        "test:local": "node --test tests/local-scene-proxy.test.mjs tests/local-scene-server.test.mjs",
        "test:all": "node scripts/run-tests.mjs --local"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "fake-indexeddb": "^6.2.5"
    }
}
